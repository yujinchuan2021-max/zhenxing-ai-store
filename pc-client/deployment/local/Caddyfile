https://localhost:4443 {
  tls internal
  root * /srv/current/public

  header {
    -Server
    X-Frame-Options "DENY"
    Referrer-Policy "no-referrer"
  }

  @health path /health
  handle @health {
    header Content-Type application/json
    header Cache-Control no-store
    respond `{"status":"ok"}` 200 {
      close
    }
  }

  @catalog path /catalog-release.json
  handle @catalog {
    header Cache-Control "public, max-age=0, must-revalidate"
    header X-Content-Type-Options "nosniff"
    reverse_proxy admin:4173 {
      header_down -Cache-Control
      header_down -X-Content-Type-Options
    }
  }

  @update path /update-release.json
  header @update {
    Cache-Control "public, max-age=0, must-revalidate"
    X-Content-Type-Options "nosniff"
  }

  @manifest path /release-manifest.json /build-provenance.json
  header @manifest {
    Cache-Control "no-store"
    X-Content-Type-Options "nosniff"
  }

  @artifacts path /artifacts/*
  header @artifacts {
    Cache-Control "public, max-age=31536000, immutable"
    X-Content-Type-Options "nosniff"
    Accept-Ranges "bytes"
  }

  @allowedFiles path /update-release.json /release-manifest.json /build-provenance.json /artifacts/AI-Hub-*-Windows-x64-Setup.exe
  handle @allowedFiles {
    file_server
  }

  handle {
    respond "not found" 404
  }
}
